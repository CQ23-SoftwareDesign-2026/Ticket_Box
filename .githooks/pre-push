#!/usr/bin/env sh
# .githooks/pre-push
#
# Git pre-push hook.
# Reads the push refs from stdin and passes them to the quality gate script.
#
# Registered via:  npm run setup:hooks
#                  (runs: git config core.hooksPath .githooks)

# Read all of stdin first so that Node.js can receive it via process.stdin / fd 0.
# We pipe stdin directly into the Node process.
node scripts/verify-push.js --hook
