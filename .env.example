# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://postgres.ovhsrgugrzbbqtlvplef:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.ovhsrgugrzbbqtlvplef:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Local dependencies
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# App secrets (set when needed)
JWT_SECRET="change-me"

# Payment gateway resilience config
PAYMENT_GATEWAY_TIMEOUT_MS="3000"

# Rate limit config for local demo/stress test.
# Railway can leave these unset because the backend has the same defaults in code.
AUTH_LOGIN_IP_BUCKET_CAPACITY="10"
AUTH_LOGIN_IP_REFILL_SECONDS="60"
AUTH_LOGIN_EMAIL_BUCKET_CAPACITY="5"
AUTH_LOGIN_EMAIL_REFILL_SECONDS="60"

CONCERT_DETAIL_IP_BUCKET_CAPACITY="120"
CONCERT_DETAIL_IP_REFILL_SECONDS="60"

TICKET_RESERVE_USER_BUCKET_CAPACITY="3"
TICKET_RESERVE_USER_REFILL_SECONDS="20"
TICKET_RESERVE_IP_BUCKET_CAPACITY="60"
TICKET_RESERVE_IP_REFILL_SECONDS="1"

# PayOS
PAYOS_CLIENT_ID="your-client-id"
PAYOS_API_KEY="your-api-key"
PAYOS_CHECKSUM_KEY="your-checksum-key"

# ============================================
# EMAIL CONFIGURATION (Resend API)
# ============================================
# Get API key from: https://resend.com/api-keys
# IMPORTANT: Use Resend API (not Gmail SMTP) for Railway deployment
RESEND_API_KEY="your-resend-api-key"

# Email sender address
# Free tier: YourApp <onboarding@resend.dev>
# Custom domain: NoReply <noreply@yourdomain.com>
EMAIL_FROM="TicketBox <noreply@yourdomain.com>"

# App URL Configurations
BACKEND_URL="https://api.ticketbox.retrobit.io.vn/"
FRONTEND_URL="http://localhost:3000"

# Supabase Storage Configuration (For uploading concert poster images and SVG seating maps)
# SUPABASE_URL: Project URL from Settings -> API (e.g. https://ovhsrgugrzbbqtlvplef.supabase.co)
# SUPABASE_KEY: service_role key or anon key from Settings -> API
# SUPABASE_BUCKET: The public bucket name created in Supabase Storage dashboard
SUPABASE_URL="https://ovhsrgugrzbbqtlvplef.supabase.co"
SUPABASE_KEY="your-supabase-service-role-key"
SUPABASE_BUCKET="concert-assets"

# Gemini API Key (For generating AI artist biography)
# Get API key from: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_TIMEOUT_MS="60000"
GEMINI_MAX_RETRIES="3"
GEMINI_RETRY_DELAY_MS="1000"
# Never enable in production. When false, provider errors mark the background job FAILED.
LLM_MOCK_ENABLED="false"
